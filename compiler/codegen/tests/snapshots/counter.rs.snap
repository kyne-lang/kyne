#![no_std]

use soroban_sdk::{contract, contractimpl, Address, Env, Symbol};

#[contract]
pub struct Counter;

#[contractimpl]
impl Counter {
    pub fn init(env: Env) {
        env.storage()
            .persistent()
            .set(&Symbol::new(&env, "count"), &(0));
    }

    pub fn increment(env: Env, by: Address) -> i64 {
        by.require_auth();
        env.storage().persistent().set(
            &Symbol::new(&env, "count"),
            &((env
                .storage()
                .persistent()
                .get::<Symbol, i64>(&Symbol::new(&env, "count"))
                .unwrap_or(0))
            .checked_add(1)
            .expect("arithmetic overflow")),
        );
        env.events().publish(
            (Symbol::new(&env, "Incremented"),),
            (
                by,
                env.storage()
                    .persistent()
                    .get::<Symbol, i64>(&Symbol::new(&env, "count"))
                    .unwrap_or(0),
            ),
        );
        return env
            .storage()
            .persistent()
            .get::<Symbol, i64>(&Symbol::new(&env, "count"))
            .unwrap_or(0);
    }

    pub fn get(env: Env) -> i64 {
        return env
            .storage()
            .persistent()
            .get::<Symbol, i64>(&Symbol::new(&env, "count"))
            .unwrap_or(0);
    }
}
